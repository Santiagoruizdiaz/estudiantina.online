# =============================================================================
# Variables de Entorno - Estudiantina de Posadas (estudiantina.online)
# Copia este archivo como .env para desarrollo local o configura en el servidor
# =============================================================================

# Puerto del servidor local (Node.js)
PORT=3000

# Entorno de ejecución: development | production | test
# En el servidor (Hostinger) usar NODE_ENV=production. Los modos development/test solo se
# respetan para conexiones locales (127.0.0.1 / ::1); desde cualquier otra IP la API PHP
# se comporta como producción.
NODE_ENV=development

# -----------------------------------------------------------------------------
# REQUERIMIENTOS CRÍTICOS DE SEGURIDAD OPERACIONAL Y SECRETOS (VULN-17 / Gate G4)
# -----------------------------------------------------------------------------
# 1. GENERACIÓN DE ALTA ENTROPÍA:
#    ADMIN_SECRET y ADMIN_TOKEN DEBEN generarse utilizando generadores
#    criptográficamente seguros con un mínimo de 32 caracteres alfanuméricos / hex.
#    Ejemplo en terminal (Linux/macOS/WSL/Git Bash):
#      openssl rand -hex 32
#    Ejemplo en PowerShell:
#      -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | ForEach-Object {[char]$_})
#
# 2. PROHIBICIÓN DE VALORES POR DEFECTO:
#    NUNCA utilices valores por defecto, predecibles o compartidos en entornos de
#    producción ni los expongas en repositorios de código.
# -----------------------------------------------------------------------------

# Clave secreta para la firma y verificación de tokens HMAC de administración
# Requerimiento: Mínimo 32 caracteres alfanuméricos / hex de alta entropía
# Generar con: openssl rand -hex 32
ADMIN_SECRET=

# Token maestro de administración (para acceso de emergencia y scripts de mantenimiento)
# Requerimiento: Mínimo 32 caracteres alfanuméricos / hex de alta entropía (distinto a ADMIN_SECRET)
# Generar con: openssl rand -hex 32
ADMIN_TOKEN=

# Contraseña inicial para la cuenta del superadministrador ('admin') al inicializar la base de datos
# Requerimiento: Contraseña de alta entropía para el primer bootstrap del sistema.
# Generar con: openssl rand -base64 18
ADMIN_INITIAL_PASSWORD=

# Identificador de cliente OAuth 2.0 de Google (Google Identity Services - GIS)
# OBLIGATORIO: sin él se rechazan todos los inicios de sesión del foro, porque no se puede
# verificar que el ID token fue emitido para esta aplicación (claim "aud").
# Debe coincidir con el client_id que usa el frontend (js/foro.js y js/comunidad.js).
# Obtenerlo en la consola de Google Cloud (APIs & Services > Credentials > OAuth 2.0 Client IDs).
# Asegurarse de autorizar los orígenes JavaScript correspondientes (ej. https://estudiantina.online, http://localhost:3000).
GOOGLE_CLIENT_ID=

# Ruta personalizada de base de datos SQLite (opcional, por defecto: data/foro.db)
# DATABASE_PATH=data/foro.db
