# =============================================================================
# Variables de Entorno - Estudiantina de Posadas (estudiantina.online)
# Copia este archivo como .env para desarrollo local o configura en el panel
# =============================================================================

# Puerto del servidor local (Node.js)
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Clave secreta para la firma y verificación de tokens HMAC de administración
ADMIN_SECRET=cambiar_por_clave_secreta_segura_minimo_32_caracteres

# Token maestro de administración (para acceso y testing de emergencia)
ADMIN_TOKEN=cambiar_por_token_maestro_seguro_unico

# Ruta personalizada de base de datos SQLite (opcional)
# DATABASE_PATH=data/foro.db
