# ==============================================================================
# CONFIGURACIÓN OPTIMIZADA PARA HOSTINGER (Apache / LiteSpeed)
# Proyecto: Estudiantina de Posadas (estudiantina.online)
# ==============================================================================

# 1. Juego de caracteres predeterminado en UTF-8
AddDefaultCharset UTF-8

# 2. Tipos MIME exactos para ES Modules de JavaScript y fuentes web
<IfModule mod_mime.c>
  AddType application/javascript              js mjs
  AddType text/css                            css
  AddType image/svg+xml                       svg svgz
  AddType application/manifest+json           webmanifest
  AddType application/json                    json
  AddType font/woff                           woff
  AddType font/woff2                          woff2
  AddType font/ttf                            ttf
  AddType audio/mpeg                          mp3
  AddType audio/wav                           wav
  AddType audio/ogg                           ogg
</IfModule>

# 3. Seguridad: Bloquear exploración de directorios, datos sensibles y archivos ocultos
Options -Indexes

<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Proteger base de datos JSON
<FilesMatch "(^ranking\.json$|\.json$)">
  <If "%{REQUEST_URI} =~ m#^/data/#">
    Require all denied
  </If>
</FilesMatch>

# 4. Enrutamiento de API y SPA Fallback Limpio
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proteger acceso directo a la carpeta data/
  RewriteRule ^data/ - [F,L]

  # Enrutar llamadas limpias de API a PHP
  RewriteRule ^api/ranking/?$ api/ranking.php [L,QSA]
  RewriteRule ^api/comunidad/?$ api/comunidad.php [L,QSA]
  RewriteRule ^api/noticias/?$ api/comunidad.php [L,QSA]
  RewriteRule ^api/foro/?$ api/foro.php [L,QSA]
  RewriteRule ^api/admin/?$ api/admin.php [L,QSA]

  # Enrutar páginas amigables
  RewriteRule ^comunidad/?$ comunidad.html [L]
  RewriteRule ^noticia/?$ noticia.html [L]

  # Si el archivo o directorio solicitado no existe físicamente, servir index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# 5. Compresión Gzip / Deflate para velocidad de carga instantánea
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 6. Caché del Navegador (Browser Caching)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Siempre fresco para actualizaciones inmediatas de versión
  ExpiresByType text/html "access plus 0 seconds"

  # CSS y JavaScript: expiración inmediata para actualizaciones instantáneas de juego
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"

  # Imágenes y multimedia: 1 mes
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fuentes y Webmanifest: 1 mes
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType font/woff "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# 7. Cabeceras de Seguridad y Control de Caché
<IfModule mod_headers.c>
  # Prevenir clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Prevenir MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Habilitar protección XSS
  Header always set X-XSS-Protection "1; mode=block"

  # Control de caché para archivos HTML, CSS y JavaScript (¡Evita bugs de versiones viejas en Hostinger!)
  <FilesMatch "\.(html|htm|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
